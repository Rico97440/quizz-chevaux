{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quiz social SOS Maréchal-Ferrant",
  "type": "object",
  "required": ["titre", "serie", "statut", "cta", "questions"],
  "properties": {
    "titre": {"type": "string", "minLength": 5},
    "serie": {"type": "string"},
    "statut": {"enum": ["idee", "recherche", "sources-a-valider", "quiz-a-valider", "validation-eric", "securite-droits-ok", "pret-a-generer", "medias-a-controler", "pret-a-publier", "publie"]},
    "cta": {"type": "string", "minLength": 3},
    "avertissement": {"type": "string"},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question", "choix", "bonne_reponse", "explication", "source_ids"],
        "properties": {
          "id": {"type": "string"},
          "question": {"type": "string"},
          "choix": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}},
          "bonne_reponse": {"type": "integer", "minimum": 1, "maximum": 3},
          "explication": {"type": "string"},
          "action_urgente": {"type": "string"},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "validation_eric": {"enum": ["non-requise", "requise", "validee"]}
        }
      }
    }
  }
}

